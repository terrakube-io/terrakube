<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Project reads filter on project_access.name and join on project_id; neither was indexed. -->
    <changeSet id="2-35-0-project-access-indexes" author="terrakube">
        <createIndex tableName="project_access" indexName="idx_project_access_project">
            <column name="project_id"/>
        </createIndex>
        <createIndex tableName="project_access" indexName="idx_project_access_name">
            <column name="name"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
