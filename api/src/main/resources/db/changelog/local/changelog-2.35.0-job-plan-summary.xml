<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- What a plan adds, changes and destroys, for run lists. Nullable, not backfilled: older and failed plans have no summary. -->
    <changeSet id="2-35-0-job-plan-summary" author="terrakube">
        <addColumn tableName="job">
            <column name="plan_add" type="int"/>
            <column name="plan_change" type="int"/>
            <column name="plan_destroy" type="int"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
