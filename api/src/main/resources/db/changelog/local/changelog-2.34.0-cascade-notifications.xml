<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <!-- Lets an existing NotificationConfiguration fire on a cascade's own outcome
         (COMPLETED/DEGRADED/BLOCKED/CANCELLED), not just a single job's status. A trigger row sets
         exactly one of job_status/cascade_status, never both - same nullable-column shape as
         changelog-2.33.1-notification-outbox-job-status.xml, extended to the trigger side. -->
    <changeSet id="2-34-0-cascade-notifications" author="jake">
        <addColumn tableName="notification_trigger">
            <column name="cascade_status" type="varchar(20)" />
        </addColumn>
    </changeSet>
</databaseChangeLog>
