<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Default tags of a project, copied onto workspaces created in or moved into it. New table only. -->
    <changeSet id="2-35-0-project-tag" author="terrakube">
        <createTable tableName="project_tag">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true"/>
            </column>
            <column name="tag_id" type="varchar(36)">
                <constraints nullable="false" foreignKeyName="fk_project_tag_tag" references="tag(id)" deleteCascade="true"/>
            </column>
            <column name="tag_value" type="varchar(256)"/>
            <column name="project_id" type="varchar(36)">
                <constraints nullable="false" foreignKeyName="fk_project_tag_project" references="project(id)"/>
            </column>
            <column name="created_date" type="datetime"/>
            <column name="updated_date" type="datetime"/>
            <column name="created_by" type="varchar2(128)"/>
            <column name="updated_by" type="varchar2(128)"/>
        </createTable>
        <addUniqueConstraint tableName="project_tag" columnNames="project_id, tag_id" constraintName="const_project_tag"/>
        <createIndex tableName="project_tag" indexName="idx_project_tag_project">
            <column name="project_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
