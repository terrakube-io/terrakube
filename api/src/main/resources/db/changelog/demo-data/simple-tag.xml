    <changeSet author="demo-data" id="demo-4-key-value-tags">
        <!--
        ********************
        ***KEY/VALUE TAGS***
        ********************
        The tags above are key-only. These two keys carry a value on every workspace, so the UI
        filter, the card/table chips and `terraform init` with `tags = { env = "..." }` all have
        something to work with:

            simple_tag1 : development, networking, env=production,  team=infra
            simple_tag2 : development, networking, env=development, team=platform
            simple_tag3 : development,             env=development
        -->
        <insert tableName="tag">
            <column name="id"               value="3e8b0c3a-6a0c-4d5e-9d6a-2b4f9a1c7d10" />
            <column name="name"             value="env" />
