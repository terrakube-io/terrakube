<?xml version="1.0" encoding="UTF-8"?>
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0 https://maven.apache.org/xsd/build-cache-config-1.2.0.xsd">
    <configuration>
        <!-- Off for local builds; CI turns it on with -Dmaven.build.cache.enabled=true. The cache does
             not track properties such as spring-boot.build-image.skip, so a hit could skip an image
             build that a developer expects. -->
        <enabled>false</enabled>
        <hashAlgorithm>XX</hashAlgorithm>
        <local>
            <!-- CI restores a fresh cache per run, so only the latest build of each module is useful. -->
            <maxBuildsCached>1</maxBuildsCached>
        </local>
        <attachedOutputs>
            <!-- Restored on a cache hit so Sonar still finds classes, tests and coverage. -->
            <dirNames>
                <dirName>classes</dirName>
                <dirName>test-classes</dirName>
                <dirName>surefire-reports</dirName>
                <dirName glob="jacoco.exec"/>
                <dirName>site</dirName>
            </dirNames>
        </attachedOutputs>
    </configuration>
</cache>
