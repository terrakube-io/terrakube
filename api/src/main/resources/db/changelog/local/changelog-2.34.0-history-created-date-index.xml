<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Backs RunTriggerDispatchService.changedState()'s per-job "ORDER BY created_date DESC LIMIT 1" lookups. -->
    <changeSet id="2-34-0-idx-history-workspace-id-created-date" author="jake">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_history_workspace_id_created_date" tableName="history"/>
            </not>
        </preConditions>
        <createIndex tableName="history" indexName="idx_history_workspace_id_created_date">
            <column name="workspace_id"/>
            <column name="created_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
