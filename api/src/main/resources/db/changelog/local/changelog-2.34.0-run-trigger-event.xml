<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="2-34-0-run-trigger-event" author="jake">
        <!-- last_error is "text", not "clob" - mirrors notification_outbox.payload/last_error;
             see changelog-2.33.0-notification.xml for why. -->
        <createTable tableName="run_trigger_event">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="job_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="status" type="varchar(20)" defaultValue="PENDING">
                <constraints nullable="false" />
            </column>
            <column name="attempt_count" type="int" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="last_attempt_at" type="datetime" />
            <!-- Null means "due as soon as picked up" (first attempt). -->
            <column name="next_attempt_at" type="datetime" />
            <column name="last_error" type="text" />
            <column name="created_date" type="datetime" />
            <column name="updated_date" type="datetime" />
            <column name="created_by" type="varchar(128)" />
            <column name="updated_by" type="varchar(128)" />
        </createTable>
        <addForeignKeyConstraint baseTableName="run_trigger_event" baseColumnNames="job_id"
            constraintName="fk_run_trigger_event_job_id" referencedTableName="job"
            referencedColumnNames="id" />
        <!-- One event per job: the enforced idempotency key, not just application logic. -->
        <addUniqueConstraint tableName="run_trigger_event" columnNames="job_id"
            constraintName="uk_run_trigger_event_job_id" />
        <!-- Backs findDueForProcessing's WHERE status = ? ORDER BY created_date. -->
        <createIndex tableName="run_trigger_event" indexName="idx_run_trigger_event_status_created_date">
            <column name="status" />
            <column name="created_date" />
        </createIndex>
        <!-- Backs the stuck-row sweep's WHERE status = PROCESSING AND last_attempt_at < ?. -->
        <createIndex tableName="run_trigger_event" indexName="idx_run_trigger_event_status_last_attempt">
            <column name="status" />
            <column name="last_attempt_at" />
        </createIndex>
    </changeSet>

</databaseChangeLog>
