<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="2-34-0-job-variables" author="terrakube">
        <addColumn tableName="job">
            <column name="encrypted_variables" type="text"/>
        </addColumn>
    </changeSet>
    <changeSet id="2-34-0-job-variable-names" author="terrakube">
        <addColumn tableName="job">
            <column name="variable_names" type="text"/>
        </addColumn>
    </changeSet>
    <changeSet id="2-34-0-job-variables-as-arguments" author="terrakube">
        <addColumn tableName="job">
            <column name="variables_as_arguments" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
