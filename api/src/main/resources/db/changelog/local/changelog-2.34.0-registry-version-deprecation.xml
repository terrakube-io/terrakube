<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!--
      Module and provider versions have one status: active, deprecated (still served, with a warning)
      or removed (no longer served by the registry). Rows are kept so the refresh jobs do not re-import them.
    -->
    <changeSet id="2-34-0-module-version-status" author="terrakube">
        <addColumn tableName="module_version">
            <column name="status" type="varchar(16)" defaultValue="active"><constraints nullable="false"/></column>
            <column name="deprecation_message" type="varchar(1024)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2-34-0-provider-version-status" author="terrakube">
        <addColumn tableName="version">
            <column name="status" type="varchar(16)" defaultValue="active"><constraints nullable="false"/></column>
            <column name="deprecation_message" type="varchar(1024)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
